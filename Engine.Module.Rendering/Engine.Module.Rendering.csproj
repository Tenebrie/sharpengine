<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>x64</Platforms>
        <GenerateDependencyFile>true</GenerateDependencyFile>
        <DebugType>embedded</DebugType>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Shipping'">
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Engine.Core.EntitySystem\Engine.Core.EntitySystem.csproj" />
        <ProjectReference Include="..\Engine.Core.Lamina\Engine.Core.Lamina.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DiligentGraphics.DiligentEngine.Core" Version="2.5.6" />
        <PackageReference Include="FontStashSharp" Version="1.3.10" />
        <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
<!--        <PackageReference Include="Microsoft.Direct3D.DXC" Version="1.8.2505.32" />-->
        <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    </ItemGroup>

    <Import Project="..\Engine.Tooling.Weaver\Weaver.targets" />
</Project>
